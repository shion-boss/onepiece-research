{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{engine,db,decks,api,scripts}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/faq/refresh", "schedule": "0 3 * * 1" }
  ]
}
